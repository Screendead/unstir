// YES builds analytics in: the consent question, the settings switch and, with APTABASE_KEY, Aptabase. NO, v1's,
// leaves all of it out, so the game asks, records and sends nothing, whatever key is set. A build with it YES must
// declare in Sources/PrivacyInfo.xcprivacy what analytics collects (product interaction, coarse location and purchase
// history, not linked, for analytics), which v1's declares empty.
ANALYTICS = NO
// Aptabase's app key stays out of the repo: put `APTABASE_KEY = A-EU-...` in Config/Local.xcconfig (gitignored), which
// Xcode's own builds and archives read, or set APTABASE_KEY in the shell for scripts/build-ios.sh. Empty leaves
// analytics off.
APTABASE_KEY =
// YES files a Release build's events as Debug in Aptabase, so playtests on the developer's phone stay out of real
// players' numbers. scripts/run-ios.sh sets it for every build it installs.
ANALYTICS_PLAYTEST =
// The support address "report a problem" mails and the privacy policy's page stay out of the repo too: put them in
// Config/Local.xcconfig, or set them in the shell for scripts/build-ios.sh. In an xcconfig `//` starts a comment, so a
// URL is written `POLICY_URL = https:/$()/example.org/privacy`. Empty, the report goes through the share sheet and the
// policy opens on github.com.
SUPPORT_ADDRESS =
POLICY_URL =
// YES makes the editors' build, for App Store editors on its own TestFlight group: settings shows a labelled switch,
// "open every tier", that opens every tier, level and pack. NO, the App Store build's, compiles the switch out.
EDITORS = NO
EDITORS_CONDITION_YES = EDITORS
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(EDITORS_CONDITION_$(EDITORS))
// YES builds Game Center in: a sign-in at the menu and the achievements (Sources/GameCenter.swift). NO, v1's until the
// sign-in overlay test passes, makes no GameKit call. A build with it YES needs the Game Center capability on its App
// ID and the com.apple.developer.game-center entitlement.
GAME_CENTER = NO
// YES syncs bests through the player's iCloud key-value store (Sources/Sync.swift) and signs with
// iCloud's entitlement. NO, until the App ID has the iCloud capability with key-value storage, makes no call to the
// store and signs without it, as a device build with that entitlement fails to provision without it. Before it turns
// YES for a release: the App ID's iCloud capability, a two-device test on one Apple ID, and docs/privacy-policy.md and
// docs/store-page.md, which say the bests stay on the phone and that iCloud sync isn't built.
ICLOUD = NO
// YES signs with Declared Age Range's entitlement (com.apple.developer.declared-age-range), which Apple's docs require
// of an app calling the API (Sources/AgeRange.swift); scripts/archive-ios.sh sets it. NO, until a phone build on the
// paid team shows the App ID takes it, keeps scripts/run-ios.sh's signing as it was. Unsigned builds ignore both.
AGE_RANGE = NO
// One file per pair of switches, ICLOUD's then AGE_RANGE's; a later entitlement (Game Center's) joins these.
ENTITLEMENTS_YES_NO = Config/iCloud.entitlements
ENTITLEMENTS_NO_YES = Config/AgeRange.entitlements
ENTITLEMENTS_YES_YES = Config/iCloudAgeRange.entitlements
CODE_SIGN_ENTITLEMENTS = $(ENTITLEMENTS_$(ICLOUD)_$(AGE_RANGE))
// YES lets a plain launch on a phone learn each glass's four-tap budget from the frames its drags miss and keep it
// (Sources/Taps.swift), starting from the static limit, so it steps down only where a phone drops frames, hot or on a
// larger glass (Jack's call taps-keep = C). NO draws the static limit; UNSTIR_TAPS still runs the law for a launch.
ADAPTIVE_TAPS = YES
#include? "Local.xcconfig"
